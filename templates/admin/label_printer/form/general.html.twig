{% set form = hookable_metadata.context.form %}

<div class="card mb-3">
    <div class="card-header">
        <h2 class="card-title">{{ 'sylius.ui.general'|trans }}</h2>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-6">{{ form_row(form.code) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.name) }}</div>
            <div class="col-12 col-md-8">{{ form_row(form.host) }}</div>
            <div class="col-12 col-md-4">{{ form_row(form.port) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.transport) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.agentUrl) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.enabled) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.default) }}</div>
        </div>
    </div>
</div>
